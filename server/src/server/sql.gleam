    "SELECT CAST(json_object('ticket_number', tickets.ticket_number, 'status', tickets.status, 'queue', queues.name, 'service', services.name, 'location', locations.name, 'tracking_token', CAST(?1 AS TEXT)) AS TEXT) AS payload
